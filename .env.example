# Copy this to .env and fill in your values
# NEVER commit .env to git

SECRET_KEY=your-secret-key-here-change-this

# Database (Neon Postgres for production, SQLite for local dev)
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require&channel_binding=require
# LOCAL DEV (SQLite — comment out DATABASE_URL above and uncomment this):
# DATABASE_URL=sqlite:///friedsports.db

# Admin auto-elevation: whoever logs in with this email gets admin role
ADMIN_EMAIL=your@email.com

# Environment
FLASK_ENV=development

# Email (optional — notifications skip gracefully if not set)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@friedsports.com
